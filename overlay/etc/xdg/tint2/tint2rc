# Warp desktop panel (tint2 17).  Per-user copy: ~/.config/tint2/tint2rc
# Flat colours, no transparency or gradients: everything the X driver can
# fill is a plain rectangle.

#-------------------------------------
# Backgrounds
# 1: panel
rounded = 0
border_width = 0
background_color = #303438 100
border_color = #000000 0

# 2: active task, menu button
rounded = 0
border_width = 1
background_color = #3060A0 100
border_color = #5080C0 100

# 3: normal task
rounded = 0
border_width = 1
background_color = #404850 100
border_color = #505860 100

# 4: iconified task
rounded = 0
border_width = 1
background_color = #202428 100
border_color = #303438 100

#-------------------------------------
# Panel
panel_items = PLTSC
panel_size = 100% 28
panel_margin = 0 0
panel_padding = 2 2 4
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
wm_menu = 1
panel_dock = 0
strut_policy = follow_size
autohide = 0
disable_transparency = 1
mouse_effects = 0
font_shadow = 0

#-------------------------------------
# Menu button: the Openbox root menu (bound to Alt+F1 in rc.xml)
button = new
button_text = Menu
button_icon = start-here
button_lclick_command = xdotool key alt+F1
button_background_id = 2
button_padding = 6 2 4
button_font = Sans Bold 9
button_font_color = #FFFFFF 100

#-------------------------------------
# Launchers
launcher_padding = 2 2 4
launcher_background_id = 0
launcher_icon_size = 22
launcher_icon_theme = Tango
launcher_item_app = /usr/share/applications/xterm.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/leafpad.desktop
launcher_tooltip = 1

#-------------------------------------
# Taskbar
taskbar_mode = single_desktop
taskbar_padding = 2 0 2
taskbar_background_id = 0
taskbar_name = 0
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 180 24
task_padding = 4 2 4
task_font = Sans 9
task_font_color = #D0D0D0 100
task_active_font_color = #FFFFFF 100
task_iconified_font_color = #909090 100
task_background_id = 3
task_active_background_id = 2
task_iconified_background_id = 4
task_tooltip = 1
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = close
mouse_scroll_up = toggle
mouse_scroll_down = iconify

#-------------------------------------
# System tray
systray_padding = 2 2 4
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 22

#-------------------------------------
# Clock
time1_format = %H:%M
time2_format = %a %d %b
time1_font = Sans Bold 9
time2_font = Sans 7
clock_font_color = #FFFFFF 100
clock_padding = 6 0
clock_background_id = 0
clock_tooltip = %A %d %B %Y
