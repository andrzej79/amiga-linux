 // Lookup table for mapping AT keycodes to their doom keycode
+/* The Amiga keyboard driver (amikbd) reports raw Amiga scancodes as
+ * keycodes; the console keymap is remapped for it at boot, but in
+ * K_MEDIUMRAW we see the raw codes. */
+static const char amiga_to_doom[0x68] =
+{
+    /* 0x00 */ '`', '1', '2', '3', '4', '5', '6', '7',
+    /* 0x08 */ '8', '9', '0', '-', '=', '\\', 0, KEYP_0,
+    /* 0x10 */ 'q', 'w', 'e', 'r', 't', 'y', 'u', 'i',
+    /* 0x18 */ 'o', 'p', '[', ']', 0, KEYP_1, KEYP_2, KEYP_3,
+    /* 0x20 */ 'a', 's', 'd', 'f', 'g', 'h', 'j', 'k',
+    /* 0x28 */ 'l', ';', '\'', 0, 0, KEYP_4, KEYP_5, KEYP_6,
+    /* 0x30 */ 0, 'z', 'x', 'c', 'v', 'b', 'n', 'm',
+    /* 0x38 */ ',', '.', '/', 0, KEYP_PERIOD, KEYP_7, KEYP_8, KEYP_9,
+    /* 0x40 */ KEY_USE, KEY_BACKSPACE, KEY_TAB, KEYP_ENTER, KEY_ENTER, KEY_ESCAPE, KEY_DEL, 0,
+    /* 0x48 */ 0, 0, KEYP_MINUS, 0, KEY_UPARROW, KEY_DOWNARROW, KEY_RIGHTARROW, KEY_LEFTARROW,
+    /* 0x50 */ KEY_F1, KEY_F2, KEY_F3, KEY_F4, KEY_F5, KEY_F6, KEY_F7, KEY_F8,
+    /* 0x58 */ KEY_F9, KEY_F10, 0, 0, KEYP_DIVIDE, KEYP_MULTIPLY, KEYP_PLUS, KEY_PAUSE, /* Help = pause */
+    /* 0x60 */ KEY_RSHIFT, KEY_RSHIFT, KEY_CAPSLOCK, KEY_FIRE, KEY_LALT, KEY_RALT, 0, 0,
+};
+
+static boolean amiga_keys;
+
 static const char at_to_doom[] =
 {
     /* 0x00 */ 0x00,
@@ -234,7 +256,7 @@ static const char shiftxform[] =
 
