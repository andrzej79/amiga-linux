+/* Copy n bytes (a multiple of 16, both 16-byte aligned) with move16 */
+static inline void copy_move16(void *dst, const void *src, int n)
+{
+#if defined(__mc68040__) || defined(__mc68060__)
+    const void *s = src;
+    void *d = dst;
+    for (n >>= 4; n > 0; n--)
+        __asm__ volatile ("move16 (%0)+,(%1)+" : "+a" (s), "+a" (d) : : "memory");
+#else
+    memcpy(dst, src, n);
+#endif
+}
