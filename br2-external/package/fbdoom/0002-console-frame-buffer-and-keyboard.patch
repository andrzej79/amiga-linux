+/* Frame buffer state */
+static struct fb_fix_screeninfo fb_fix;
+static byte *fb_mem;                /* mmap of the whole frame buffer */
+static byte *fb_origin;             /* top-left pixel of Doom's window */
+static int fb_bytespp;
+static uint32_t fb_lut[256];        /* palette index -> pixel (16/32 bpp) */
+static struct fb_cmap fb_saved_cmap;
+static uint16_t fb_saved_r[256], fb_saved_g[256], fb_saved_b[256];
+static boolean fb_cmap_saved;
+static int kd_tty = -1;             /* tty switched to KD_GRAPHICS */
+static struct fb_var_screeninfo fb_saved_var;
+static boolean fb_mode_changed;
+
+extern void kbd_restore(void);
+
+static void I_RestoreConsole(void)
+{
+    kbd_restore();
+    if (fb_mode_changed) {
+        fb_saved_var.activate = FB_ACTIVATE_NOW | FB_ACTIVATE_FORCE;
+        ioctl(fd_fb, FBIOPUT_VSCREENINFO, &fb_saved_var);
+        fb_mode_changed = false;
+    }
+    if (fb_cmap_saved) {
+        ioctl(fd_fb, FBIOPUTCMAP, &fb_saved_cmap);
+        fb_cmap_saved = false;
+    }
+    if (kd_tty >= 0) {
+        ioctl(kd_tty, KDSETMODE, KD_TEXT);
+        kd_tty = -1;
+    }
+}
+
+static void I_FatalSignal(int sig)
+{
+    I_RestoreConsole();
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
