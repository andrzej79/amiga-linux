+/*
+ * 32-bit values in chip memory (PTDs): little-endian, except on a 32-bit bus
+ * wired straight to a big-endian CPU (bus_be), where they arrive in CPU byte
+ * order.  Payload is moved raw either way (verified on the FreeWay Triton).
+ */
+static inline u32 isp1760_val_read(bool be, void __iomem *addr)
+{
+	return be ? __raw_readl(addr) : readl_relaxed(addr);
+}
+
+static inline void isp1760_val_write(bool be, u32 val, void __iomem *addr)
+{
+	if (be)
+		__raw_writel(val, addr);
+	else
+		writel_relaxed(val, addr);
+}
