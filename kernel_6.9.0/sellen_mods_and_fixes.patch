 {
 	int ret, any_ret = -ENODEV;
@@ -284,6 +382,11 @@ static int __init isp1760_init(void)
 	if (!ret)
 		any_ret = 0;
 #endif
+#ifdef CONFIG_ZORRO
+	ret = zorro_register_driver(&isp1760_zorro_driver);
+	if (!ret)
+		any_ret = 0;
+#endif
 
 	if (any_ret)
 		isp1760_deinit_kmem_cache();
@@ -296,6 +399,9 @@ static void __exit isp1760_exit(void)
 	platform_driver_unregister(&isp1760_plat_driver);
 #ifdef CONFIG_USB_PCI
 	pci_unregister_driver(&isp1761_pci_driver);
+#endif
+#ifdef CONFIG_ZORRO
+	zorro_unregister_driver(&isp1760_zorro_driver);
 #endif
 	isp1760_deinit_kmem_cache();
 }
