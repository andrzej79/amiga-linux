 {
@@ -270,6 +278,96 @@ static struct platform_driver isp1760_plat_driver = {
 	},
 };
 
+#ifdef CONFIG_ZORRO
+/*
+ * FreeWay Triton: the ISP1760 sits 1 MB into the Zorro III board, on a 32-bit
+ * bus wired straight to the 68k (big-endian).  Its interrupt reaches INT6
+ * inverted, so the chip drives it active-high.  Two board registers, used as
+ * the AmigaOS driver (freewaytritonz3usb.device 1.01) uses them:
+ *  +0xE0000: bit 2 pulses the chip's reset; bit 1 (with bit 1 of +0xC0000)
+ *            lets its interrupt through to INT6.
+ */
+#define TRITON_ISP1760_OFFSET	SZ_1M
+#define TRITON_ISP1760_SIZE	SZ_64K
+#define TRITON_CTRL_C		0xc0000
+#define TRITON_CTRL_E		0xe0000
+#define TRITON_CTRL_E_RESET	BIT(2)
+#define TRITON_CTRL_IRQ_EN	BIT(1)
+
+static void triton_ctrl_write(struct zorro_dev *z, unsigned long reg, u32 val)
+{
+	void __iomem *p = ioremap(zorro_resource_start(z) + reg, 4);
+
+	if (p) {
+		z_writel(val, p);
+		iounmap(p);
+	}
+}
+
+static int isp1760_zorro_int = 6;
+module_param_named(zorro_int, isp1760_zorro_int, int, 0444);
+MODULE_PARM_DESC(zorro_int, "Amiga interrupt level of Zorro boards: 6 (default) or 2");
+
+static int isp1760_zorro_probe(struct zorro_dev *z,
+			       const struct zorro_device_id *ent)
+{
+	struct resource *mem;
+	int irq, ret;
+
+	if (isp1760_zorro_int != 2 && isp1760_zorro_int != 6) {
+		dev_err(&z->dev, "zorro_int=%d: must be 2 or 6\n", isp1760_zorro_int);
+		return -EINVAL;
+	}
+	irq = isp1760_zorro_int == 6 ? IRQ_AMIGA_EXTER : IRQ_AMIGA_PORTS;
+
+	mem = devm_kzalloc(&z->dev, sizeof(*mem), GFP_KERNEL);
+	if (!mem)
+		return -ENOMEM;
+	mem->name = "isp1760";
+	mem->start = zorro_resource_start(z) + TRITON_ISP1760_OFFSET;
+	mem->end = mem->start + TRITON_ISP1760_SIZE - 1;
+	mem->flags = IORESOURCE_MEM;
+
+	dev_info(&z->dev, "FreeWay Triton: ISP1760 at %pR, INT%d\n", mem,
+		 isp1760_zorro_int);
+
+	/* hardware reset of the chip, interrupt gate closed */
+	triton_ctrl_write(z, TRITON_CTRL_E, TRITON_CTRL_E_RESET);
+	msleep(1);
+	triton_ctrl_write(z, TRITON_CTRL_E, 0);
+	msleep(5);
+
+	ret = isp1760_register(mem, irq, 0, &z->dev,
+			       ISP1760_FLAG_BIG_ENDIAN_BUS | ISP1760_FLAG_INTR_POL_HIGH);
+	if (ret)
+		return ret;
+
+	/* the handler is in place: let the chip's interrupt through */
+	triton_ctrl_write(z, TRITON_CTRL_C, TRITON_CTRL_IRQ_EN);
+	triton_ctrl_write(z, TRITON_CTRL_E, TRITON_CTRL_IRQ_EN);
+	return 0;
+}
+
+static void isp1760_zorro_remove(struct zorro_dev *z)
+{
+	triton_ctrl_write(z, TRITON_CTRL_E, 0);
+	isp1760_unregister(&z->dev);
+}
+
+static const struct zorro_device_id isp1760_zorro_ids[] = {
+	{ ZORRO_PROD_MATTHIAS_HAMPEL_FREEWAY_TRITON },
+	{ 0 }
+};
+MODULE_DEVICE_TABLE(zorro, isp1760_zorro_ids);
+
+static struct zorro_driver isp1760_zorro_driver = {
+	.name		= "isp1760-zorro",
+	.id_table	= isp1760_zorro_ids,
+	.probe		= isp1760_zorro_probe,
+	.remove		= isp1760_zorro_remove,
+};
+#endif
