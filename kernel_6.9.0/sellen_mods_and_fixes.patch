diff --git a/drivers/mfd/Kconfig b/drivers/mfd/Kconfig
index 4b023ee..4533237 100644
--- a/drivers/mfd/Kconfig
+++ b/drivers/mfd/Kconfig
@@ -11,6 +11,21 @@ config MFD_CORE
 	select IRQ_DOMAIN
 	default n
 
+config MFD_CSWARP
+	tristate "CS-Lab Warp turbo board core"
+	depends on AMIGA && ZORRO
+	select MFD_CORE
+	help
+	  Core driver for the CS-Lab Warp Amiga turbo boards (Warp560,
+	  Warp1240/1260/1260X, Warp7060, ...).  It owns the board's control
+	  registers, the dual-port RAM command channel to the board's ARM
+	  and its INT2 interrupt, and creates the network, IDE and RTG
+	  framebuffer function devices.
+
+	  Requires Warp firmware package 3.000 or later.
+
+	  Debug messages: cswarp_core.dbg=<mask> on the kernel command line.
+
 config MFD_CS5535
 	tristate "AMD CS5535 and CS5536 southbridge core functions"
 	select MFD_CORE
