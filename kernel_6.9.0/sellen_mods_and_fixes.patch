@@ -276,6 +302,7 @@ static int __init amiga_a3000_scsi_probe(struct platform_device *pdev)
 fail_host:
 	free_irq(IRQ_AMIGA_PORTS, instance);
 fail_irq:
+	kfree(hdata->bounce);
 	scsi_host_put(instance);
 fail_alloc:
 	release_mem_region(res->start, resource_size(res));
@@ -291,6 +318,7 @@ static void __exit amiga_a3000_scsi_remove(struct platform_device *pdev)
 	hdata->regs->CNTR = 0;
 	scsi_remove_host(instance);
 	free_irq(IRQ_AMIGA_PORTS, instance);
+	kfree(hdata->bounce);
 	scsi_host_put(instance);
 	release_mem_region(res->start, resource_size(res));
 }
