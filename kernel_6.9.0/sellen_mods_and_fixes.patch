diff --git a/drivers/scsi/a3000.c b/drivers/scsi/a3000.c
index 378906f..1117cda 100644
--- a/drivers/scsi/a3000.c
+++ b/drivers/scsi/a3000.c
@@ -27,8 +27,26 @@ struct a3000_hostdata {
 	struct WD33C93_hostdata wh;
